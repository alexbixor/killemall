; nx_vars.inc - Kill'em all Spectrum Next engine: shared addresses (spec docs/next_engine_spec_v0.1.md section 8/10).
; Included first by every program (main.asm and the lane test wrappers). NO code here, only equates.

; ---- 8K bank 8 in slot 0 (tables, generated by tools/nx_tables.py)
SIN_TAB     equ 0800h          ; 1024 words, round(256*sin)
COS_TAB     equ 1000h          ; 1024 words
RD_TAB      equ 1800h          ; 256 words: RD[k] = min(65535, 65536 // k), RD[0] = 65535
ZBUF        equ 1A00h          ; 128 words (depth Q8 per column)
; ---- 8K bank 9 in slot 1
RECIP_TAB   equ 2000h          ; 4096 words: RECIP[i] = min(65535, 65536 // i), RECIP[0] = 65535

; ---- screen (16K bank 5 in slots 2,3)
SCR_TOP     equ 4000h          ; rows 0..47, 128 bytes per row
SCR_BOT     equ 6000h          ; rows 48..95

; ---- variables 5800h..5FFFh
frames      equ 5800h          ; word
px          equ 5802h          ; word Q8
py          equ 5804h          ; word Q8
ang         equ 5806h          ; word 0..1023
ticks       equ 5808h          ; word (ISR)
eye         equ 580Ah          ; byte int8 H32
isr_sp      equ 580Ch          ; word
dirx        equ 5810h          ; word signed Q8
diry        equ 5812h
plx         equ 5814h
ply         equ 5816h
mx0         equ 5818h          ; byte start cell x
my0         equ 5819h          ; byte start cell y
; draw_piece parameter block
pc_c        equ 5820h          ; byte column 0..127
pc_ra       equ 5821h          ; byte first row
pc_count    equ 5822h          ; byte rows (>= 1)
pc_tex      equ 5823h          ; byte wall texture 0..15
pc_s        equ 5824h          ; byte shade 0..3
pc_u        equ 5825h          ; byte texture column 0..31
pc_v        equ 5826h          ; word texel row Q8 of the first pixel (0..8191)
pc_dv       equ 5828h          ; word texel rows per screen row Q8
; plane_add parameter block
pl_c        equ 5830h          ; byte column
pl_h        equ 5831h          ; byte int8 height H32
pl_tex      equ 5832h          ; byte floor texture 0..7
pl_a        equ 5833h          ; byte first row
pl_b        equ 5834h          ; byte end row (exclusive)
; void_fill parameter block
vd_c        equ 5838h          ; byte column
vd_a        equ 5839h          ; byte first row
vd_b        equ 583Ah          ; byte end row (exclusive)
; walker scratch (lane D1 owns 5840h..58FFh), drawers scratch (lane D2 owns 5900h..59FFh)
WALK_VARS   equ 5840h
DRAW_VARS   equ 5900h
; stacks
MAIN_STACK  equ 5F00h          ; grows down from here
ISR_STACK   equ 5FF0h

; ---- code bank (16K bank 2 in slots 4,5)
PLANES      equ 0A800h         ; 15 planes x 258 bytes (lane D2 layout), 0A800h..0B71Fh
NPLANES     equ 15
LEVEL       equ 0B800h         ; 32x16 cells x 4 bytes = 2048 bytes
LEVEL_W     equ 32
LEVEL_H     equ 16

; ---- texture slots
WALL_SLOT   equ 0C000h         ; 8K bank 16 + (tex >> 1); page = 0C0h + (tex and 1)*16 + s*4 + (u >> 3); byte in page = (u and 7)*32 + v
FLOOR_SLOT  equ 0E000h         ; 8K bank 24; page = 0E0h + f*4 + s; byte in page = u*16 + v
WALL_BANK0  equ 16
FLOOR_BANK  equ 24
TABLE_BANK0 equ 8
; Z80N nextreg write: db 0EDh,091h,reg,val ; nextreg reg,a: db 0EDh,092h,reg
NR_MMU0     equ 50h
NR_MMU6     equ 56h
NR_MMU7     equ 57h
